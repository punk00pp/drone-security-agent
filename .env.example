# Copy this file to .env and fill in your values.
# Never commit .env to the repository.

# ── LLM (Groq) ───────────────────────────────────────────────────────────────
# Used by LLMAnalyzer and the LangChain agent.
# Get your free key at https://console.groq.com
# Model: qwen/qwen3.8-27b (hardcoded in analyzer.py — change there if needed)
API_KEY=your_groq_api_key_here

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Required for persistent storage across sessions and page refreshes.
# Without this, the app falls back to a local SQLite file (data lost on restart).
# Free options: https://neon.tech  |  https://supabase.com
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Nomic (embeddings) ────────────────────────────────────────────────────────
# Required for semantic search (vector store).
# Get your token at https://atlas.nomic.ai → Settings → API Keys
# Then run once in terminal: nomic login <token>
# If NOMIC_API_KEY is set here it is used automatically without the CLI login.
NOMIC_API_KEY=your_nomic_api_key_here

# ── Vector store path ────────────────────────────────────────────────────────
# Local ChromaDB directory. On read-only filesystems (Streamlit Cloud)
# the app falls back to in-memory automatically.
CHROMA_PATH=chroma_db

# ── Analyzer ─────────────────────────────────────────────────────────────────
# rule  = offline regex/keyword, no API key needed, used in all tests
# llm   = Groq-backed, requires API_KEY above
DEFAULT_ANALYZER=rule
